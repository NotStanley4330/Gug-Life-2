{
	$basetexture "gug/drinkinghat"
	$bumpmap "gug/drinkinghat_normalmap"
	$surfaceprop Metal

	$envmap "env_cubemap"
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.98 0.71 0.45]"
